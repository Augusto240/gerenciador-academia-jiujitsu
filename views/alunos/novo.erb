<header>
  <img src="/logo.png" alt="Logo JPM Team" class="logo">
  <h1>➕ Cadastrar Novo Aluno</h1>
  <p class="subtitle">Preencha os dados do aluno</p>
  <a href="/" class="btn-secondary" aria-label="Voltar para a lista de alunos">⬅ Voltar para a Lista</a>
</header>

<section class="card form-section">
  <h2>📋 Dados do Aluno</h2>
  <form action="/alunos" method="POST">
    <%= csrf_tag %>
    <label for="nome">👤 Nome:</label>
    <input type="text" id="nome" name="nome" placeholder="Digite o nome completo" required minlength="3" maxlength="100" aria-label="Nome do aluno" autocomplete="name">

    <label for="modalidade">🥋 Modalidade:</label>
    <select name="modalidade" id="modalidade" onchange="atualizarFaixas()" required aria-label="Modalidade">
      <% @modalidades.each do |mod| %>
        <option value="<%= mod %>"><%= mod %></option>
      <% end %>
    </select>

    <label for="cor_faixa">🥋 Cor da Faixa:</label>
    <select name="cor_faixa" id="cor_faixa" required aria-label="Cor da faixa">
      <% @faixas.each do |faixa| %>
        <option value="<%= faixa %>"><%= faixa %></option>
      <% end %>
    </select>

    <label for="data_nascimento">📅 Data de Nascimento:</label>
    <input type="date" id="data_nascimento" name="data_nascimento" aria-label="Data de nascimento" max="<%= Date.today %>">

    <label for="turma">👥 Turma:</label>
    <select name="turma" id="turma" required aria-label="Turma">
      <% @turmas.each do |turma| %>
        <option value="<%= turma %>"><%= turma %></option>
      <% end %>
    </select>

    <div class="checkbox-container">
      <input type="checkbox" id="bolsista" name="bolsista" aria-label="Marcar como bolsista">
      <label for="bolsista">🏆 Bolsista?</label>
    </div>

    <h3 class="form-title">🏥 Informações de Saúde (opcional)</h3>

    <label for="saude_problema">Problema de Saúde:</label>
    <input type="text" id="saude_problema" name="saude_problema" placeholder="Ex: Asma, diabetes...">

    <label for="saude_medicacao">Uso de Medicação:</label>
    <input type="text" id="saude_medicacao" name="saude_medicacao" placeholder="Ex: Nenhuma">

    <label for="saude_lesao">Histórico de Lesões:</label>
    <input type="text" id="saude_lesao" name="saude_lesao" placeholder="Ex: Lesão no joelho">

    <label for="saude_substancia">Uso de Substâncias:</label>
    <input type="text" id="saude_substancia" name="saude_substancia" placeholder="Ex: Nenhuma">

    <button type="submit" class="btn-primary">✓ Cadastrar Aluno</button>
  </form>
</section>