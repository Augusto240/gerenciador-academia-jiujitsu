<header>
  <img src="/logo.png" alt="Logo JPM Team" class="logo">
  <h1>✅ Lista de Presença</h1>
  <% da = @aula['data_aula'].is_a?(String) ? Date.parse(@aula['data_aula']) : @aula['data_aula'] %>
  <p class="subtitle">🥋 Aula de: <strong><%= da.strftime('%d/%m/%Y') %></strong> - <%= @aula['turma'] %> (<%= @aula['modalidade'] %>)</p>
  <p><%= h @aula['descricao'] %></p>
  <div class="action-buttons">
    <a href="/aulas" class="btn-secondary" aria-label="Voltar para lista de aulas">⬅ Voltar</a>
    <a href="/aulas/<%= @aula['id'] %>/editar" class="btn-primary" aria-label="Editar aula">✏️ Editar</a>
    <form action="/aulas/<%= @aula['id'] %>" method="POST" style="display: inline;" data-confirm="Tem certeza que deseja excluir esta aula? Esta ação não pode ser desfeita.">
      <%= csrf_tag %>
      <input type="hidden" name="_method" value="DELETE">
      <button type="submit" class="btn-danger" aria-label="Excluir aula">🗑️ Excluir</button>
    </form>
  </div>
</header>

<section class="list-section card">
  <h2>👥 Marque os Alunos Presentes</h2>
  <form action="/aulas/<%= @aula['id'] %>/presencas" method="POST">
    <%= csrf_tag %>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>✅ Presente?</th>
            <th>👤 Nome do Aluno</th>
          </tr>
        </thead>
        <tbody>
          <% @lista_presenca.each do |aluno| %>
            <tr>
              <td>
                <input type="checkbox"
                       name="presentes[]"
                       value="<%= aluno['id'] %>"
                       style="width: 28px; height: 28px; accent-color: #F9A825;"
                       <%= 'checked' if aluno['presente'] == 't' || aluno['presente'] == true %>>
              </td>
              <td><strong><%= h aluno['nome'] %></strong></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <button type="submit" class="btn-salvar-presenca">
      ✓ Salvar Lista de Presença
    </button>
  </form>
</section>
