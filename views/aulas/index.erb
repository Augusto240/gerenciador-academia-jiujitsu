<header>
  <img src="/logo.png" alt="Logo JPM Team" class="logo">
  <h1>🥋 Aulas e Presença</h1>
  <p class="subtitle">Registre aulas e controle presenças</p>
</header>

<section class="card form-section">
  <h2>➕ Registrar Nova Aula</h2>
  <form action="/aulas" method="POST">
    <%= csrf_tag %>
    <label for="data_aula">📅 Data da Aula:</label>
    <input type="date" name="data_aula" value="<%= Date.today.strftime('%Y-%m-%d') %>" required>

    <label for="modalidade_aula">🥋 Modalidade:</label>
    <select name="modalidade" id="modalidade_aula" onchange="atualizarTurmasAula()">
      <% @modalidades.each do |mod| %>
        <option value="<%= mod %>"><%= mod %></option>
      <% end %>
    </select>

    <label for="descricao">📝 Descrição (opcional):</label>
    <input type="text" name="descricao" placeholder="Ex: Treino de Passagem de Guarda">

    <div id="turma-container">
      <label for="turma">👥 Para qual turma?</label>
      <select name="turma" id="turma">
        <option value="">— Escolha uma turma —</option>
        <% @turmas.each do |t| %>
          <option value="<%= t %>"><%= t %></option>
        <% end %>
      </select>
    </div>

    <div class="checkbox-container" id="todas-turmas-container">
      <input type="checkbox" id="todas_turmas" name="todas_turmas">
      <label for="todas_turmas">
        Registrar presença para <strong>todos</strong> os alunos (independente da turma)
      </label>
    </div>

    <button type="submit" class="btn-primary">✓ Criar Aula e Abrir Lista de Presença</button>
  </form>

  <script>
    const turmasJiuJitsu = <%= @turmas.to_json %>;
    const turmasMuayThai = <%= @turmas_muay_thai.to_json %>;
    
    function atualizarTurmasAula() {
      const modalidade = document.getElementById('modalidade_aula').value;
      const selectTurma = document.getElementById('turma');
      const turmaContainer = document.getElementById('turma-container');
      const todasTurmasContainer = document.getElementById('todas-turmas-container');
      
      if (modalidade === 'Muay Thai') {
        // Muay Thai tem turma única, esconder seleção e marcar automaticamente
        turmaContainer.style.display = 'none';
        todasTurmasContainer.style.display = 'none';
        selectTurma.innerHTML = '<option value="Muay Thai" selected>Muay Thai</option>';
      } else {
        // Jiu Jitsu tem várias turmas
        turmaContainer.style.display = 'block';
        todasTurmasContainer.style.display = 'flex';
        selectTurma.innerHTML = '<option value="">— Escolha uma turma —</option>';
        turmasJiuJitsu.forEach(turma => {
          const option = document.createElement('option');
          option.value = turma;
          option.textContent = turma;
          selectTurma.appendChild(option);
        });
      }
    }
  </script>
</section>

<section class="list-section card">
  <h2>📋 Aulas Registradas</h2>
  
  <!-- Filtro de busca -->
  <form action="/aulas" method="GET" class="filter-form" style="margin-bottom: 20px;">
    <input type="date" name="data_inicio" placeholder="Data Início" value="<%= params[:data_inicio] %>">
    <input type="date" name="data_fim" placeholder="Data Fim" value="<%= params[:data_fim] %>">
    <select name="turma_filtro">
      <option value="">Todas as Turmas</option>
      <% @turmas.each do |t| %>
        <option value="<%= t %>" <%= 'selected' if params[:turma_filtro] == t %>><%= t %></option>
      <% end %>
      <% @turmas_muay_thai.each do |t| %>
        <option value="<%= t %>" <%= 'selected' if params[:turma_filtro] == t %>><%= t %></option>
      <% end %>
    </select>
    <div class="button-group">
      <button type="submit" class="btn-primary">🔍 Filtrar</button>
      <a href="/aulas" class="btn-secondary">✖ Limpar</a>
    </div>
  </form>
  
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>📅 Data</th>
          <th>🥋 Modalidade</th>
          <th>👥 Turma</th>
          <th>📝 Descrição</th>
          <th>⚙️ Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @aulas.each do |aula| %>
          <% da = aula['data_aula'].is_a?(String) ? Date.parse(aula['data_aula']) : aula['data_aula'] %>
          <tr>
            <td><strong><%= da.strftime('%d/%m/%Y') %></strong></td>
            <td><%= h(aula['modalidade'] || 'Jiu Jitsu') %></td>
            <td><%= h(aula['turma'] || '—') %></td>
            <td><%= h aula['descricao'] %></td>
            <td>
              <a href="/aulas/<%= aula['id'] %>" class="btn-editar">
                ✏ Ver / Editar Presença
              </a>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <% if @total_paginas && @total_paginas > 1 %>
  <div class="paginacao">
    <% if @pagina_atual > 1 %>
      <a href="/aulas?pagina=<%= @pagina_atual - 1 %>" class="btn-paginacao">← Anterior</a>
    <% end %>
    
    <span class="pagina-info">Página <%= @pagina_atual %> de <%= @total_paginas %> (<%= @total_aulas %> aulas)</span>
    
    <% if @pagina_atual < @total_paginas %>
      <a href="/aulas?pagina=<%= @pagina_atual + 1 %>" class="btn-paginacao">Próxima →</a>
    <% end %>
  </div>
  <% end %>
</section>
