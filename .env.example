# ==============================================
# Configurações do Ambiente - Academia JPM Team
# ==============================================
# Copie este arquivo para .env e preencha os valores

# Ambiente de Execução
RACK_ENV=development

# Banco de Dados
DATABASE_HOST=db
DATABASE_USER=jiujitsu_user
DATABASE_PASSWORD=sua_senha_segura_aqui
DATABASE_NAME=academia_jiujitsu_dev
DATABASE_URL=

# Pool de Conexões
DB_POOL_SIZE=10

# Sessão (gerar com: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)")
SESSION_SECRET=gere_um_secret_seguro_com_pelo_menos_64_caracteres_aqui

# Porta da Aplicação
PORT=4567
# Configurações da Academia
DEFAULT_MENSALIDADE=70.00